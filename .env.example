# StayNas / NoVA Hospitality local environment
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-only credential for trusted API routes. Never prefix with VITE_.
# Never expose this value to browser code or commit a populated value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional StayNas website demo-request email notification.
# Requests are stored even when email notification is not configured.
STAYNAS_DEMO_NOTIFICATION_EMAIL=
STAYNAS_DEMO_FROM_EMAIL=

# Optional StayNas product website analytics (analytics scripts load only after visitor consent).
VITE_STAYNAS_GA4_MEASUREMENT_ID=
VITE_STAYNAS_GTM_CONTAINER_ID=
