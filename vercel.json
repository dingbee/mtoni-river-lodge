{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/site.webmanifest",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "nolmarkcdma.staynas.com"
          }
        }
      ],
      "destination": "/nolmarkcdma.webmanifest",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "nolmarkcdma.staynas.com"
          }
        }
      ],
      "destination": "/nolmark-cdma-staynas",
      "permanent": false
    },
    {
      "source": "/book/:path*",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "nolmarkcdma.staynas.com"
          }
        }
      ],
      "destination": "/nolmark-cdma-staynas",
      "permanent": false
    },
    {
      "source": "/rooms/:path*",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "nolmarkcdma.staynas.com"
          }
        }
      ],
      "destination": "/nolmark-cdma-staynas",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/internal/communications/recovery",
      "schedule": "*/5 * * * *"
    }
  ]
}
