{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "nolmarkcdma\\.staynas\\.com"
        }
      ],
      "destination": "/nolmark-cdma-staynas"
    },
    {
      "source": "/site.webmanifest",
      "has": [
        {
          "type": "host",
          "value": "nolmarkcdma\\.staynas\\.com"
        }
      ],
      "destination": "/nolmarkcdma.webmanifest"
    }
  ]
}
