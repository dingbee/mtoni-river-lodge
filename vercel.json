{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/site.webmanifest",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "nolmarkcdma.staynas.com"
          }
        }
      ],
      "destination": "/nolmarkcdma.webmanifest",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "nolmarkcdma.staynas.com"
          }
        }
      ],
      "destination": "/nolmark-cdma-staynas",
      "permanent": false
    },
    {
      "source": "/book/:path*",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "nolmarkcdma.staynas.com"
          }
        }
      ],
      "destination": "/nolmark-cdma-staynas",
      "permanent": false
    },
    {
      "source": "/rooms/:path*",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "nolmarkcdma.staynas.com"
          }
        }
      ],
      "destination": "/nolmark-cdma-staynas",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/guest/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, private, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
